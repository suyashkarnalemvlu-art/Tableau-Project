      <aliases enabled='yes' />
      <column caption='Cost' datatype='real' name='[Calculation_0986863158849536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([approx_cost(for two people)])' />
      </column>
      <column caption='Estimated Sales' datatype='real' name='[Calculation_0986863160111105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0986863158849536] * [votes]' />
      </column>
      <column caption='Estimated Profit' datatype='real' name='[Calculation_0986863160209410]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0986863160111105] * 0.20' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0986863160348675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0986863160209410]) / SUM([Calculation_0986863160111105])' />
      </column>
      <column caption='Rating' datatype='real' name='[Calculation_0986863161196548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(REPLACE([rate], &quot;/5&quot;, &quot;&quot;))' />
      </column>
      <column caption='Frequency Segment' datatype='string' name='[Calculation_0986863169785861]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [votes] &gt;= 1000 THEN&#13;&#10;    &quot;High Frequency&quot;&#13;&#10;ELSEIF [votes] &gt;= 500 THEN&#13;&#10;    &quot;Medium Frequency&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Frequency&quot;&#13;&#10;END' />
      </column>
      <column caption='Monetary Segment' datatype='string' name='[Calculation_0986863210250247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0986863158849536] &gt;= 1000 THEN&#13;&#10;    &quot;High Monetary&quot;&#13;&#10;ELSEIF [Calculation_0986863158849536] &gt;= 500 THEN&#13;&#10;    &quot;Medium Monetary&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Monetary&quot;&#13;&#10;END' />
      </column>
      <column caption='Restaurant Value' datatype='real' name='[Calculation_0986863211102216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0986863158849536] * [votes]' />
      </column>
      <column caption='High Value Restaurant' datatype='string' name='[Calculation_0986863214563337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0986863211102216] &gt;= 500000 THEN&#13;&#10;    &quot;High Value&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Other&quot;&#13;&#10;END' />
      </column>
